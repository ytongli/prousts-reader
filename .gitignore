# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# Next.js and build output
.next/
out/
dist/

# miscellaneous system files and private keys
.DS_Store
*.pem
*.key
*.p12
*.pfx

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment files
.env*
!.env.example
!.env.*.example

# Cloudflare local secrets
.dev.vars
.dev.vars.*
!.dev.vars.example

# Vercel
.vercel/

# TypeScript
next-env.d.ts
*.tsbuildinfo

# Cloudflare, Sites, and local generated state
.wrangler/
.sites-runtime/

# local working and generated output directories
outputs/
work/
